<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>MicaFlyouts</RootNamespace>
    <AssemblyName>MicaFlyouts</AssemblyName>
    <Version>215.0.2</Version>
    <AssemblyVersion>215.0.2.0</AssemblyVersion>
    <FileVersion>215.0.2.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkIncludeVersionInfo>true</WindowsAppSdkIncludeVersionInfo>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\MicaFlyouts.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And ('$(Platform)' == '' Or '$(Platform)' == 'AnyCPU' Or '$(Platform)' == 'Any CPU')">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <InvariantGlobalization>false</InvariantGlobalization>
    <LangVersion>preview</LangVersion>
    <!-- <GenerateDocumentationFile>false</GenerateDocumentationFile> -->
    <!--  CS1591 Generate documents "Missing XML comment"  -->
    <!-- <NoWarn>$(NoWarn);CS1591</NoWarn> -->
    <WarningsAsErrors>$(WarningsAsErrors);CsWinRT1028;CsWinRT1030</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Labs.Notifications" />
    <PackageReference Include="Microsoft.UI.Reactor" />
    <PackageReference Include="Microsoft.Web.WebView2" VersionOverride="*" ExcludeAssets="All" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="Microsoft.Windows.CsWin32" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="Kumo.H.NotifyIcon.Reactor" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <!-- Required for AOT; trimming this assembly makes the Settings window crash on open. -->
    <TrimmerRootAssembly Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Infrastructure\Interop\NativeMethods.txt" />
    <AdditionalFiles Include="Strings\**\*.resw" />
    <EmbeddedResource Include="Assets\MicaFlyouts.ico" LogicalName="MicaFlyouts.Assets.MicaFlyouts.ico" />
    <EmbeddedResource Include="Assets\TrayIcons\*.ico" />
    <Content Include="Assets\MicaFlyouts.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\**\*" Exclude="Assets\MicaFlyouts.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Strings\**\*.resw" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    These publish sidecars duplicate resources already embedded in $(AssemblyName).pri:
    - Directory.Build.targets copies $(TargetDir)Reactor\**\*.xbf using RecursiveDir,
      so Reactor\Hosting\ReactorApplication.xbf also lands at Hosting\ReactorApplication.xbf.
    - Microsoft.UI.Reactor.targets copies Reactor.pri and Reactor\Hosting\* to PublishDir.
      Reactor.pri is a MakePRI input, and MicaFlyouts.pri contains ReactorApplication.xbf
      as EmbeddedData. The app PRI is retained; these loose copies are not needed at runtime.
    When GenerateDocumentationFile is enabled, $(AssemblyName).xml is documentation only.
  -->
  <Target Name="RemoveReactorAotPublishArtifacts"
          AfterTargets="Publish"
          DependsOnTargets="_CopyWinUIResourcesForAot"
          Condition="'$(PublishAot)' == 'true'">
    <Delete Files="$(PublishDir)$(AssemblyName).xml" />
    <Delete Files="$(PublishDir)Reactor.pri" />
    <RemoveDir Directories="$(PublishDir)Reactor" />
    <RemoveDir Directories="$(PublishDir)Hosting" />
  </Target>
</Project>
